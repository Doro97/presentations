"""
bandit.py

A thin wrapper around Vowpal Wabbit's contextual bandit mode.

Key concepts:
  Arms    : the products we can recommend (100 products = 100 arms)
  Context : who is visiting and how (location, time, device, intent)
  Reward  : 1 if user is satisfied, else 0
  Cost    : NEGATIVE of reward — VW minimizes cost
            cost = -reward  →  reward=1 becomes cost=-1 (good)
                               reward=0 becomes cost=0  (neutral)
  Explore : sample from VW's probability distribution (not argmax)
  Exploit : high probability arms get chosen more often via sampling

The loop is always:
  predict → sample from PMF → observe reward → learn

Key implementation notes:
  - Use vowpalwabbit.Workspace (not pyvw) for LabelType support
  - Use vw.parse() + LabelType.CONTEXTUAL_BANDIT + vw.finish_example()
    This is required for correct learning — plain model.learn(string) does not
    update weights correctly for context learning
  - Softmax lambda=2.0 gives visible score differences with 100 arms
  - -q ui creates quadratic interaction features between |user and |item namespaces
    Required for context-item association learning
"""

import re
import json
import warnings
warnings.filterwarnings("ignore")
import random
from pathlib import Path
import vowpalwabbit  # must be imported before pandas to avoid segfault
import numpy as np
import pandas as pd


# ── VW Format Helpers ─────────────────────────────────────────────────────────

def _clean(text: str) -> str:
    """Remove characters that have special meaning in VW format."""
    return re.sub(r"[|:\s]+", "_", str(text).lower().strip())


def build_shared_context(context: dict) -> str:
    """Build the shared line — the user/session context for this round."""
    location    = _clean(context.get("location",    "unknown"))
    time_of_day = _clean(context.get("time_of_day", "unknown"))
    device      = _clean(context.get("device",      "unknown"))
    intent      = _clean(context.get("intent",      "unknown"))
    is_weekend  = int(context.get("is_weekend", 0))
    reviewer_id = _clean(context.get("reviewer_id", "unknown"))

    return (
        f"shared |user "
        f"location_{location}=1 "
        f"time_{time_of_day}=1 "
        f"device_{device}=1 "
        f"intent_{intent}=1 "
        f"is_weekend={is_weekend} "
        f"reviewer_{reviewer_id}=1"
    )


def build_arm_line(arm_index: int, product: dict,
                   cost: float = None, prob: float = None) -> str:
    """Build one arm line for a single product."""
    category  = _clean(product.get("category",          "unknown"))
    rating    = round(float(product.get("avg_rating",           3.0)), 2)
    log_count = round(float(product.get("log_review_count",     1.0)), 3)
    words     = product.get("name_words", "")

    label = f"0:{cost}:{prob}" if cost is not None else ""

    return (
        f"{label} |item "
        f"cat_{category}=1 "
        f"rating={rating} "
        f"log_count={log_count} "
        f"{words}"
    ).strip()


def build_vw_example(context: dict, products: list,
                     chosen_index: int = None,
                     cost: float = None,
                     prob: float = None) -> str:
    """Assemble a full multi-line VW contextual bandit example."""
    lines = [build_shared_context(context)]

    for i, product in enumerate(products):
        if chosen_index is not None and i == chosen_index:
            lines.append(build_arm_line(i, product, cost=cost, prob=prob))
        else:
            lines.append(build_arm_line(i, product))

    return "\n".join(lines)


# ── Sampling ──────────────────────────────────────────────────────────────────

def sample_pmf(scores: list) -> tuple:
    """Sample an arm from VW's probability distribution.

    Must SAMPLE not argmax — sampling enables exploration.
    Returns chosen_index and its probability (needed for learn).
    """
    r          = random.random()
    cumulative = 0.0
    for i, p in enumerate(scores):
        cumulative += p
        if r <= cumulative:
            return i, p
    return len(scores) - 1, scores[-1]


# ── Bandit ────────────────────────────────────────────────────────────────────

class ContextualBandit:
    """VW contextual bandit for product recommendation."""

    MODEL_PATH = "model.vw"
    META_PATH  = "model_meta.json"

    def __init__(self, lmbda: float = 10.0):
        self.lmbda              = lmbda
        self.total_interactions = 0
        self.total_reward       = 0
        self.model              = vowpalwabbit.Workspace(
            f"--cb_explore_adf --softmax --lambda {lmbda} -q ui --cb_type dr --learning_rate 2.0 --quiet"
        )

    def predict(self, context: dict, products: list) -> tuple:
        """Score all products, sample from the PMF, return chosen arm.

        Uses vw.parse() + finish_example() — required for correct
        context learning with cb_explore_adf.

        Returns:
          chosen_index : sampled arm index
          prob         : probability of chosen arm (pass back to learn)
          scores       : full probability list (for display)
        """
        example            = build_vw_example(context, products)
        vw_ex              = self.model.parse(example, vowpalwabbit.LabelType.CONTEXTUAL_BANDIT)
        scores             = self.model.predict(vw_ex)
        self.model.finish_example(vw_ex)
        chosen_index, prob = sample_pmf(scores)
        return chosen_index, prob, scores

    def learn(self, context: dict, products: list,
              chosen_index: int, reward: float, prob: float):
        """Update the model with the observed outcome.

        Uses vw.parse() + finish_example() — required for correct
        context learning with cb_explore_adf.

        cost = -reward:
          reward=1 → cost=-1  (good)
          reward=0 → cost=0   (neutral)
        """
        cost    = 1.0 - reward
        example = build_vw_example(
            context, products,
            chosen_index=chosen_index,
            cost=cost,
            prob=prob,
        )
        vw_ex = self.model.parse(example, vowpalwabbit.LabelType.CONTEXTUAL_BANDIT)
        self.model.learn(vw_ex)
        self.model.finish_example(vw_ex)
        self.total_interactions += 1
        self.total_reward       += reward

    @property
    def ctr(self) -> float:
        if self.total_interactions == 0:
            return 0.0
        return self.total_reward / self.total_interactions

    # ── Persistence ───────────────────────────────────────────────────────────

    def save(self):
        """Save model weights and metadata to disk."""
        self.model.save(self.MODEL_PATH)
        meta = {
            "total_interactions": self.total_interactions,
            "total_reward":       self.total_reward,
            "lmbda":              self.lmbda,
        }
        with open(self.META_PATH, "w") as f:
            json.dump(meta, f)

    @classmethod
    def load(cls) -> "ContextualBandit":
        """Load model from disk if it exists."""
        if not Path(cls.MODEL_PATH).exists():
            raise FileNotFoundError(f"No saved model found at {cls.MODEL_PATH}")

        with open(cls.META_PATH, "r") as f:
            meta = json.load(f)

        lmbda    = meta.get("lmbda", 2.0)
        instance = cls.__new__(cls)
        instance.lmbda              = lmbda
        instance.total_interactions = meta["total_interactions"]
        instance.total_reward       = meta["total_reward"]
        model_path = str(Path(cls.MODEL_PATH).resolve())
        instance.model              = vowpalwabbit.Workspace(
            f"--cb_explore_adf --softmax --lambda {lmbda} -q ui --cb_type dr --learning_rate 2.0 --quiet "
            f"-i \"{model_path}\""
        )
        return instance

    @classmethod
    def load_or_create(cls, lmbda: float = 2.0) -> "ContextualBandit":
        """Load existing model or create fresh one."""
        try:
            instance = cls.load()
            print(f"Loaded saved model. Interactions: {instance.total_interactions}")
            return instance
        except FileNotFoundError:
            print("No saved model found. Starting fresh.")
            return cls(lmbda=lmbda)
